{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ API key": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "API key %@"
          }
        }
      }
    },
    "%@, %@, 1 tael": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, 1 lượng"
          }
        }
      }
    },
    "%lld on": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld đang bật"
          }
        }
      }
    },
    "1 %@ in VND": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 %@ ra VND"
          }
        }
      }
    },
    "Add at least one trigger word, or Moonee will never use the skill.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ít nhất một từ kích hoạt, nếu không Moonee sẽ không bao giờ dùng skill này."
          }
        }
      }
    },
    "Apple Intelligence doesn't speak your language on this iPhone yet, so Moonee replied in English.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence trên iPhone này chưa hỗ trợ tiếng Việt, nên Moonee trả lời bằng tiếng Anh nhé."
          }
        }
      }
    },
    "Apple Intelligence doesn't support this language yet.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence chưa hỗ trợ ngôn ngữ này."
          }
        }
      }
    },
    "Apple Intelligence wouldn't answer that one.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence không chịu trả lời câu này."
          }
        }
      }
    },
    "Built-in": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có sẵn"
          }
        }
      }
    },
    "Can't use this skill": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dùng được skill này"
          }
        }
      }
    },
    "Crypto prices": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá tiền ảo"
          }
        }
      }
    },
    "Delete skill": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá skill"
          }
        }
      }
    },
    "Edited": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sửa"
          }
        }
      }
    },
    "For other questions (stocks, interest rates, news), add a Tavily or Brave key, or use OpenRouter, OpenAI, Anthropic or Gemini.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với câu hỏi khác (chứng khoán, lãi suất, tin tức), hãy thêm key Tavily hoặc Brave, hoặc dùng OpenRouter, OpenAI, Anthropic hay Gemini."
          }
        }
      }
    },
    "Give the skill a name.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đặt tên cho skill."
          }
        }
      }
    },
    "Gold prices": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá vàng"
          }
        }
      }
    },
    "Gold prices, exchange rates and crypto come from PNJ, Vietcombank and CoinGecko; only the item you ask about is sent, never your data.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá vàng, tỷ giá và tiền ảo lấy từ PNJ, Vietcombank và CoinGecko; chỉ gửi đi thứ bạn hỏi, không bao giờ gửi dữ liệu của bạn."
          }
        }
      }
    },
    "Gold, exchange rates and crypto always come from PNJ, Vietcombank and CoinGecko, no key needed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá vàng, tỷ giá và tiền ảo luôn lấy từ PNJ, Vietcombank và CoinGecko, không cần key."
          }
        }
      }
    },
    "Gold, exchange rates, crypto and news, with sources. Uses web search.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá vàng, tỷ giá, tiền ảo và tin tức, kèm nguồn. Có dùng tìm kiếm web."
          }
        }
      }
    },
    "Import a .md file": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập file .md"
          }
        }
      }
    },
    "Instructions": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn"
          }
        }
      }
    },
    "Jar balances": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư các lọ"
          }
        }
      }
    },
    "Market lookup": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra cứu thị trường"
          }
        }
      }
    },
    "Moonee asked your other on-device model instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee nhờ model còn lại trên máy trả lời thay nhé."
          }
        }
      }
    },
    "Moonee used the app's own numbers for now.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee tạm trả lời bằng số liệu có sẵn trong app nhé."
          }
        }
      }
    },
    "Moonee uses your skill when a question contains one of its trigger words. Numbers still come from the app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee dùng skill của bạn khi câu hỏi có một trong các từ kích hoạt. Mọi con số vẫn do app tính."
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên"
          }
        }
      }
    },
    "New skill": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skill mới"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt"
          }
        }
      }
    },
    "Ready, but Apple Intelligence doesn't speak your language yet: Moonee answers in English": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sẵn sàng, nhưng Apple Intelligence chưa hỗ trợ tiếng Việt: Moonee sẽ trả lời bằng tiếng Anh"
          }
        }
      }
    },
    "Recent transactions": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch gần đây"
          }
        }
      }
    },
    "Remove the API key, password or token from the skill: it would be sent to the AI.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xoá API key, mật khẩu hoặc token khỏi skill: chúng sẽ bị gửi cho AI."
          }
        }
      }
    },
    "Reset to default": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục mặc định"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu"
          }
        }
      }
    },
    "Savings plan": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch tiết kiệm"
          }
        }
      }
    },
    "Search key": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Key tìm kiếm"
          }
        }
      }
    },
    "Searching with %@'s built-in search.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang dùng tìm kiếm có sẵn của %@."
          }
        }
      }
    },
    "Searching with your %@ key.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tìm bằng key %@ của bạn."
          }
        }
      }
    },
    "Short version for on-device models": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản rút gọn cho model trên máy"
          }
        }
      }
    },
    "Spending summary": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng chi tiêu"
          }
        }
      }
    },
    "Split an income": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia một khoản thu"
          }
        }
      }
    },
    "That was a bit long for the on-device model.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu này hơi dài so với model trên máy."
          }
        }
      }
    },
    "The file needs a front matter block between --- lines with name, description, triggers and tools.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "File cần phần đầu nằm giữa hai dòng --- gồm name, description, triggers và tools."
          }
        }
      }
    },
    "The on-device model hit a snag.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model trên máy vừa gặp trục trặc."
          }
        }
      }
    },
    "The skill is too long (20 KB at most).": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skill quá dài (tối đa 20 KB)."
          }
        }
      }
    },
    "Tools it may use": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool được phép dùng"
          }
        }
      }
    },
    "Trigger words, separated by commas": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ kích hoạt, cách nhau bằng dấu phẩy"
          }
        }
      }
    },
    "Unknown tools: %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool không có trong Moonee: %@."
          }
        }
      }
    },
    "Web search": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm web"
          }
        }
      }
    },
    "Web search is off.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm web đang tắt."
          }
        }
      }
    },
    "What it is for": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng để làm gì"
          }
        }
      }
    },
    "When you ask about prices, rates or news, your search query is sent to %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn hỏi về giá cả, tỷ giá hay tin tức, nội dung tìm kiếm được gửi tới %@."
          }
        }
      }
    },
    "Write the skill's instructions.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy viết hướng dẫn cho skill."
          }
        }
      }
    },
    "Written for the AI. Never put API keys or passwords here.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết cho AI đọc. Đừng bao giờ để API key hay mật khẩu ở đây."
          }
        }
      }
    },
    "Your skills": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skill của bạn"
          }
        }
      }
    },
    "buy": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "mua vào"
          }
        }
      }
    },
    "buy, cash": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "mua tiền mặt"
          }
        }
      }
    },
    "buy, transfer": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "mua chuyển khoản"
          }
        }
      }
    },
    "sell": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "bán ra"
          }
        }
      }
    }
  }
}
