    "Plain gold rings 999.9": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຫວນຄຳລຽບ 999.9"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แหวนทองเกลี้ยง 999.9"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhẫn trơn 999.9"
          }
        }
      }
    },
    "Read photos and receipts": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອ່ານຮູບ ແລະ ໃບບິນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านรูปและใบเสร็จ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc ảnh và hoá đơn"
          }
        }
      }
    },
    "Receipts, transfer screenshots, bills and statements. Off: only Moonee's built-in rules read them.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃບບິນ, ພາບໜ້າຈໍການໂອນ, ໃບແຈ້ງໜີ້ ແລະ ລາຍການເຄື່ອນໄຫວບັນຊີ. ປິດ: ໃຊ້ສະເພາະກົດໃນຕົວຂອງ Moonee ອ່ານ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใบเสร็จ ภาพหน้าจอการโอน บิล และรายการเดินบัญชี ปิด: ใช้เฉพาะกฎในตัวของ Moonee อ่าน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoá đơn, ảnh chụp chuyển khoản, hoá đơn dịch vụ và sao kê. Tắt: chỉ dùng quy tắc có sẵn của Moonee để đọc."
          }
        }
      }
    },
    "Recent transactions": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍການລ່າສຸດ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
