{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ API key": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "API key ຂອງ %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "API key ของ %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "API key %@"
          }
        }
      }
    },
    "%@, %@, 1 tael": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@, 1 ຕຳລຶງຈີນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@, 1 ตำลึงจีน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, 1 lượng"
          }
        }
      }
    },
    "%lld on": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປີດຢູ່ %lld"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดอยู่ %lld"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld đang bật"
          }
        }
      }
    },
    "1 %@ in VND": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "1 %@ ເປັນ VND"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1 %@ เป็น VND"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 %@ ra VND"
          }
        }
      }
    },
    "Add at least one trigger word, or Moonee will never use the skill.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມຄຳເອີ້ນໃຊ້ຢ່າງໜ້ອຍໜຶ່ງຄຳ ບໍ່ດັ່ງນັ້ນ Moonee ຈະບໍ່ໃຊ້ສະກິວນີ້ເລີຍ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคำเรียกใช้อย่างน้อยหนึ่งคำ ไม่อย่างนั้น Moonee จะไม่ใช้สกิลนี้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ít nhất một từ kích hoạt, nếu không Moonee sẽ không bao giờ dùng skill này."
          }
        }
      }
    },
    "Built-in": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມີໃນຕົວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีในตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có sẵn"
          }
        }
      }
    },
    "Can't use this skill": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃຊ້ສະກິວນີ້ບໍ່ໄດ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สกิลนี้ไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dùng được skill này"
          }
        }
      }
    },
    "Crypto prices": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຄາຄຣິບໂຕ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคาคริปโต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá tiền ảo"
          }
        }
      }
    },
    "Debt book": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sổ nợ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมุดหนี้"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ປຶ້ມໜີ້"
          }
        }
      }
    },
    "Delete skill": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລຶບສະກິວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบสกิล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá skill"
          }
        }
      }
    },
    "Edited": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແກ້ໄຂແລ້ວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sửa"
          }
        }
      }
    },
    "For other questions (stocks, interest rates, news), add a Tavily or Brave key, or use OpenRouter, OpenAI, Anthropic or Gemini.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສຳລັບຄຳຖາມອື່ນ (ຮຸ້ນ, ອັດຕາດອກເບ້ຍ, ຂ່າວ) ໃຫ້ເພີ່ມຄີ Tavily ຫຼື Brave ຫຼື ໃຊ້ OpenRouter, OpenAI, Anthropic ຫຼື Gemini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับคำถามอื่น (หุ้น ดอกเบี้ย ข่าว) ให้เพิ่มคีย์ Tavily หรือ Brave หรือใช้ OpenRouter, OpenAI, Anthropic หรือ Gemini"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với câu hỏi khác (chứng khoán, lãi suất, tin tức), hãy thêm key Tavily hoặc Brave, hoặc dùng OpenRouter, OpenAI, Anthropic hay Gemini."
          }
        }
      }
    },
    "Give the skill a name.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕັ້ງຊື່ໃຫ້ສະກິວແດ່"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งชื่อให้สกิลด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đặt tên cho skill."
          }
        }
      }
    },
    "Gold bars 999.9": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳແທ່ງ 999.9"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทองคำแท่ง 999.9"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vàng miếng 999.9"
          }
        }
      }
    },
    "Gold prices": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຄາຄຳ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคาทอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá vàng"
          }
        }
      }
    },
    "Gold prices, exchange rates and crypto prices are always looked up on the internet, no key needed.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຄາຄຳ, ອັດຕາແລກປ່ຽນ ແລະ ລາຄາຄຣິບໂຕ ຊອກຫາຈາກອິນເຕີເນັດສະເໝີ, ບໍ່ຕ້ອງໃຊ້ຄີ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคาทอง อัตราแลกเปลี่ยน และราคาคริปโต ค้นจากอินเทอร์เน็ตเสมอ ไม่ต้องใช้คีย์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá vàng, tỷ giá và giá tiền ảo luôn được tra cứu trên internet, không cần key."
          }
        }
      }
    },
    "Gold prices, exchange rates and crypto prices are looked up on the internet. Moonee only sends what you ask about, never your data.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຄາຄຳ, ອັດຕາແລກປ່ຽນ ແລະ ລາຄາຄຣິບໂຕ ຊອກຫາຈາກອິນເຕີເນັດ. Moonee ສົ່ງໄປພຽງສິ່ງທີ່ທ່ານຖາມ, ບໍ່ເຄີຍສົ່ງຂໍ້ມູນຂອງທ່ານ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคาทอง อัตราแลกเปลี่ยน และราคาคริปโต ค้นจากอินเทอร์เน็ต Moonee ส่งไปแค่สิ่งที่คุณถาม ไม่ส่งข้อมูลของคุณเลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá vàng, tỷ giá và giá tiền ảo được tra cứu trên internet. Moonee chỉ gửi đi điều bạn hỏi, không bao giờ gửi dữ liệu của bạn."
          }
        }
      }
    },
    "Gold, exchange rates, crypto and news, with sources. Uses web search.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳ, ອັດຕາແລກປ່ຽນ, ຄຣິບໂຕ ແລະ ຂ່າວ ພ້ອມແຫຼ່ງທີ່ມາ ໃຊ້ການຊອກຫາເວັບ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทอง อัตราแลกเปลี่ยน คริปโต และข่าว พร้อมแหล่งที่มา ใช้การค้นหาเว็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá vàng, tỷ giá, tiền ảo và tin tức, kèm nguồn. Có dùng tìm kiếm web."
          }
        }
      }
    },
    "Import a .md file": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ນຳເຂົ້າໄຟລ໌ .md"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าไฟล์ .md"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập file .md"
          }
        }
      }
    },
    "Instructions": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳສັ່ງ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn"
          }
        }
      }
    },
    "Jar balances": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍອດເງິນໃນກະປຸກ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดคงเหลือในกระปุก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư các lọ"
          }
        }
      }
    },
    "Market lookup": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກວດລາຄາຕະຫຼາດ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช็กราคาตลาด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra cứu thị trường"
          }
        }
      }
    },
    "Moonee asked your cloud model instead.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ເລີຍຖາມໂມເດວຄລາວແທນເດີ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee เลยถามโมเดลคลาวด์แทนนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee nhờ model cloud trả lời thay nhé."
          }
        }
      }
    },
    "Moonee used the app's own numbers for now.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕອນນີ້ Moonee ໃຊ້ຕົວເລກໃນແອັບໄປກ່ອນເດີ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ Moonee ใช้ตัวเลขในแอปไปก่อนนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee tạm trả lời bằng số liệu có sẵn trong app nhé."
          }
        }
      }
    },
    "Moonee uses your skill when a question contains one of its trigger words. Numbers still come from the app.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ຈະໃຊ້ສະກິວຂອງເຈົ້າເມື່ອຄຳຖາມມີຄຳເອີ້ນໃຊ້ຄຳໃດຄຳໜຶ່ງ ຕົວເລກທັງໝົດຍັງຄຳນວນໂດຍແອັບຄືເກົ່າ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee จะใช้สกิลของคุณเมื่อคำถามมีคำเรียกใช้คำใดคำหนึ่ง ตัวเลขทั้งหมดยังคำนวณโดยแอปเหมือนเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee dùng skill của bạn khi câu hỏi có một trong các từ kích hoạt. Mọi con số vẫn do app tính."
          }
        }
      }
    },
