{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ · needs %@ of memory": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ຕ້ອງໃຊ້ໜ່ວຍຄວາມຈຳ %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ต้องใช้หน่วยความจำ %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · cần %@ bộ nhớ"
          }
        }
      }
    },
    "%lld models": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld model"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld models"
                }
              }
            }
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ໂມເດວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld โมเดล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld model"
          }
        }
      }
    },
    "%lld models for this iPhone": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld model for this iPhone"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld models for this iPhone"
                }
              }
            }
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ໂມເດວສຳລັບ iPhone ເຄື່ອງນີ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld โมเดลสำหรับ iPhone เครื่องนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld model cho iPhone này"
          }
        }
      }
    },
    "4B quality in a 1 GB download.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຸນນະພາບລະດັບ 4B ດາວໂຫຼດພຽງ 1 GB"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณภาพระดับ 4B ดาวน์โหลดแค่ 1 GB"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất lượng 4B trong gói tải 1 GB."
          }
        }
      }
    },
    "8B quality in a 2.3 GB download.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຸນນະພາບລະດັບ 8B ດາວໂຫຼດພຽງ 2.3 GB"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณภาพระดับ 8B ดาวน์โหลดแค่ 2.3 GB"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất lượng 8B trong gói tải 2,3 GB."
          }
        }
      }
    },
    "All-rounders with hybrid thinking and wide language support, Vietnamese included.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເກັ່ງຮອບດ້ານ ມີໂໝດຄິດແບບໄຮບຣິດ ຮອງຮັບຫຼາຍພາສາ ລວມທັງພາສາຫວຽດນາມ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก่งรอบด้าน มีโหมดคิดแบบไฮบริด รองรับหลายภาษา รวมถึงภาษาเวียดนาม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model toàn diện, có chế độ suy luận, hỗ trợ nhiều ngôn ngữ, gồm cả tiếng Việt."
          }
        }
      }
    },
    "Best Vietnamese parsing in our tests.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອ່ານລາຍການພາສາຫວຽດນາມໄດ້ດີທີ່ສຸດໃນການທົດສອບຂອງພວກເຮົາ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านรายการภาษาเวียดนามได้ดีที่สุดในการทดสอบของเรา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc giao dịch tiếng Việt tốt nhất trong thử nghiệm của chúng tôi."
          }
        }
      }
    },
    "Compact and quick.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ນ້ອຍ ແລະ ໄວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล็กและเร็ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gọn và nhanh."
          }
        }
      }
    },
    "Compact, efficient models. Chinese and English first: Vietnamese is basic.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂມເດວນ້ອຍ ແລະ ປະຫຍັດ ເນັ້ນພາສາຈີນ ແລະ ອັງກິດ: ພາສາຫວຽດນາມແມ່ນພື້ນຖານ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลเล็กและประหยัด เน้นภาษาจีนและอังกฤษ: ภาษาเวียดนามแค่พื้นฐาน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model gọn và tiết kiệm. Ưu tiên tiếng Trung và tiếng Anh: tiếng Việt ở mức cơ bản."
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລຶບ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá"
          }
        }
      }
    },
    "Delete %@": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລຶບ %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá %@"
          }
        }
      }
    },
    "Delete this model?": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລຶບໂມເດວນີ້ບໍ?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบโมเดลนี้?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá model này?"
          }
        }
      }
    },
    "Download": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດາວໂຫຼດ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải về"
          }
        }
      }
    },
    "Download over Wi-Fi only": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດາວໂຫຼດຜ່ານ Wi-Fi ເທົ່ານັ້ນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดผ่าน Wi-Fi เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tải qua Wi-Fi"
          }
        }
      }
    },
    "Downloaded": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດາວໂຫຼດແລ້ວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tải"
          }
        }
      }
    },
    "Downloading %@": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກຳລັງດາວໂຫຼດ %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังดาวน์โหลด %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải %@"
          }
        }
      }
    },
    "Fast general chat.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຊັດທົ່ວໄປໄດ້ໄວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชตทั่วไปได้รวดเร็ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện chung, nhanh."
          }
        }
      }
    },
    "Featured": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄັດສັນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดสรร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nổi bật"
          }
        }
      }
    },
    "First word in %@ s · %lld tokens/s": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳທຳອິດໃນ %@ ວິ · %lld ໂທເຄັນ/ວິ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแรกใน %@ วิ · %lld โทเค็น/วิ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chữ đầu sau %@ giây · %lld token/giây"
          }
        }
      }
    },
    "Frees %@. You can download it again later.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄືນພື້ນທີ່ %@ ດາວໂຫຼດໃໝ່ໄດ້ພາຍຫຼັງ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนพื้นที่ %@ ดาวน์โหลดใหม่ได้ภายหลัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải phóng %@. Bạn có thể tải lại sau."
          }
        }
      }
    },
    "Google's open models made for phones. The best Vietnamese here, but heavier.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂມເດວແບບເປີດຂອງ Google ທີ່ສ້າງມາເພື່ອມືຖື ພາສາຫວຽດນາມດີທີ່ສຸດໃນນີ້ ແຕ່ໜັກກວ່າ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลแบบเปิดของ Google ที่ทำมาเพื่อมือถือ ภาษาเวียดนามดีที่สุดในนี้ แต่หนักกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model mở của Google làm cho điện thoại. Tiếng Việt tốt nhất ở đây, nhưng nặng hơn."
          }
        }
      }
    },
    "High CPU usage": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃຊ້ CPU ສູງ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ CPU สูง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốn CPU"
          }
        }
      }
    },
    "In use": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກຳລັງໃຊ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang dùng"
          }
        }
      }
    },
    "Larger Gemma for phones with plenty of memory.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma ລຸ້ນໃຫຍ່ ສຳລັບເຄື່ອງທີ່ມີໜ່ວຍຄວາມຈຳຫຼາຍ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma รุ่นใหญ่ สำหรับเครื่องที่มีหน่วยความจำเยอะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma lớn hơn, cho máy nhiều bộ nhớ."
          }
        }
      }
    },
    "Larger LFM with better answers.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "LFM ລຸ້ນໃຫຍ່ ຕອບໄດ້ດີກວ່າ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "LFM รุ่นใหญ่ ตอบได้ดีกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LFM lớn hơn, trả lời tốt hơn."
          }
        }
      }
    },
    "Licence: %@": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃບອະນຸຍາດ: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญาอนุญาต: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấy phép: %@"
          }
        }
      }
    },
    "Local models need a real iPhone: the Simulator has no GPU for them.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂມເດວໃນເຄື່ອງຕ້ອງໃຊ້ iPhone ແທ້: Simulator ບໍ່ມີ GPU ໃຫ້ໃຊ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลในเครื่องต้องใช้ iPhone จริง: Simulator ไม่มี GPU ให้ใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model local cần iPhone thật: Simulator không có GPU để chạy."
          }
        }
      }
    },
    "Manage models": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຈັດການໂມເດວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการโมเดล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý model"
          }
        }
      }
    },
    "Mixture of experts: big-model answers at small-model speed.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixture of Experts: ຕອບໄດ້ແບບໂມເດວໃຫຍ່ ດ້ວຍຄວາມໄວແບບໂມເດວນ້ອຍ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixture of Experts: ตอบได้แบบโมเดลใหญ่ ด้วยความเร็วแบบโมเดลเล็ก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiến trúc nhiều chuyên gia: trả lời như model lớn với tốc độ model nhỏ."
          }
        }
      }
    },
    "Models run fully on this iPhone: private, offline and free. They are downloaded from Hugging Face, never bundled with the app.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂມເດວເຮັດວຽກໃນ iPhone ເຄື່ອງນີ້ທັງໝົດ: ເປັນສ່ວນຕົວ, ໃຊ້ອອບລາຍໄດ້ ແລະ ຟຣີ ດາວໂຫຼດຈາກ Hugging Face ບໍ່ໄດ້ຕິດມາກັບແອັບ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลทำงานบน iPhone เครื่องนี้ทั้งหมด: เป็นส่วนตัว ใช้ออฟไลน์ได้ และฟรี ดาวน์โหลดจาก Hugging Face ไม่ได้ติดมากับแอป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model chạy hoàn toàn trên iPhone này: riêng tư, không cần mạng và miễn phí. Model được tải từ Hugging Face, không đóng gói sẵn trong app."
          }
        }
      }
    },
    "New": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃໝ່"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mới"
          }
        }
      }
    },
    "Not enough free space on this iPhone.": {
