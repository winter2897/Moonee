            "value": "Lựa chọn cân bằng: tiếng Việt tốt mà vẫn nhanh."
          }
        }
      }
    },
    "Thinking": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄິດວິເຄາະ"
