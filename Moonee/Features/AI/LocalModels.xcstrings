{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ · needs %@ of memory": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · cần %@ bộ nhớ"
          }
        }
      }
    },
    "%lld models": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld model"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld model"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld models"
                }
              }
            }
          }
        }
      }
    },
    "%lld models for this iPhone": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld model cho iPhone này"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld model for this iPhone"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld models for this iPhone"
                }
              }
            }
          }
        }
      }
    },
    "4B quality in a 1 GB download.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất lượng 4B trong gói tải 1 GB."
          }
        }
      }
    },
    "8B quality in a 2.3 GB download.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất lượng 8B trong gói tải 2,3 GB."
          }
        }
      }
    },
    "All-rounders with hybrid thinking and wide language support, Vietnamese included.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model toàn diện, có chế độ suy luận, hỗ trợ nhiều ngôn ngữ, gồm cả tiếng Việt."
          }
        }
      }
    },
    "Best Vietnamese parsing in our tests.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc giao dịch tiếng Việt tốt nhất trong thử nghiệm của chúng tôi."
          }
        }
      }
    },
    "Compact and quick.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gọn và nhanh."
          }
        }
      }
    },
    "Compact, efficient models. Chinese and English first: Vietnamese is basic.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model gọn và tiết kiệm. Ưu tiên tiếng Trung và tiếng Anh: tiếng Việt ở mức cơ bản."
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá"
          }
        }
      }
    },
    "Delete %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá %@"
          }
        }
      }
    },
    "Delete this model?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá model này?"
          }
        }
      }
    },
    "Download": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải về"
          }
        }
      }
    },
    "Download over Wi-Fi only": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tải qua Wi-Fi"
          }
        }
      }
    },
    "Downloaded": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tải"
          }
        }
      }
    },
    "Downloading %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải %@"
          }
        }
      }
    },
    "Fast general chat.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện chung, nhanh."
          }
        }
      }
    },
    "Featured": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nổi bật"
          }
        }
      }
    },
    "First word in %@ s · %lld tokens/s": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chữ đầu sau %@ giây · %lld token/giây"
          }
        }
      }
    },
    "Frees %@. You can download it again later.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải phóng %@. Bạn có thể tải lại sau."
          }
        }
      }
    },
    "Google's open models made for phones. The best Vietnamese here, but heavier.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model mở của Google làm cho điện thoại. Tiếng Việt tốt nhất ở đây, nhưng nặng hơn."
          }
        }
      }
    },
    "High CPU usage": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốn CPU"
          }
        }
      }
    },
    "In use": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang dùng"
          }
        }
      }
    },
    "Larger Gemma for phones with plenty of memory.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma lớn hơn, cho máy nhiều bộ nhớ."
          }
        }
      }
    },
    "Larger LFM with better answers.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LFM lớn hơn, trả lời tốt hơn."
          }
        }
      }
    },
    "Licence: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấy phép: %@"
          }
        }
      }
    },
    "Local models need a real iPhone: the Simulator has no GPU for them.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model local cần iPhone thật: Simulator không có GPU để chạy."
          }
        }
      }
    },
    "Manage models": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý model"
          }
        }
      }
    },
    "Mixture of experts: big-model answers at small-model speed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiến trúc nhiều chuyên gia: trả lời như model lớn với tốc độ model nhỏ."
          }
        }
      }
    },
    "Models run fully on this iPhone: private, offline and free. They are downloaded from Hugging Face, never bundled with the app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model chạy hoàn toàn trên iPhone này: riêng tư, không cần mạng và miễn phí. Model được tải từ Hugging Face, không đóng gói sẵn trong app."
          }
        }
      }
    },
    "New": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mới"
          }
        }
      }
    },
    "Not enough free space on this iPhone.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone không đủ dung lượng trống."
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng"
          }
        }
      }
    },
    "Paused at %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng ở %@"
          }
        }
      }
    },
    "Reasons step by step before it answers.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suy luận từng bước trước khi trả lời."
          }
        }
      }
    },
    "Recommended": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất"
          }
        }
      }
    },
    "Resume": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải tiếp"
          }
        }
      }
    },
    "Smallest Bonsai, very light on memory.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonsai nhỏ nhất, rất nhẹ bộ nhớ."
          }
        }
      }
    },
    "Smallest Qwen: quick replies, simple expense logging.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen nhỏ nhất: trả lời nhanh, ghi chi tiêu đơn giản."
          }
        }
      }
    },
    "Smarter answers, but slower and warmer.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời thông minh hơn, nhưng chậm hơn và làm máy ấm hơn."
          }
        }
      }
    },
    "Stronger reasoning in a small size.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suy luận tốt hơn trong kích thước nhỏ."
          }
        }
      }
    },
    "Ternary (2-bit) models: big-model answers in a small download. Vietnamese is basic.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ba trạng thái (2-bit): câu trả lời như model lớn mà dung lượng nhỏ. Tiếng Việt ở mức cơ bản."
          }
        }
      }
    },
    "Test speed": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo tốc độ"
          }
        }
      }
    },
    "Testing speed…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang đo tốc độ…"
          }
        }
      }
    },
    "The balanced pick: good Vietnamese at a quick pace.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn cân bằng: tiếng Việt tốt mà vẫn nhanh."
          }
        }
      }
    },
    "Thinking": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suy luận"
          }
        }
      }
    },
    "This iPhone has %@ of RAM; Moonee can use about %@ for a model. Models that need more are hidden.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone này có %@ RAM; Moonee dùng được khoảng %@ cho model. Model cần nhiều hơn sẽ được ẩn."
          }
        }
      }
    },
    "This iPhone has too little memory for a local model. Use Apple Intelligence or your own API key instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone này không đủ bộ nhớ cho model local. Hãy dùng Apple Intelligence hoặc API key của bạn."
          }
        }
      }
    },
    "Tiny and instant. English only in practice.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rất nhỏ, trả lời tức thì. Thực tế chỉ dùng tốt tiếng Anh."
          }
        }
      }
    },
    "Tiny and very fast, for short English answers.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rất nhỏ và rất nhanh, cho câu trả lời tiếng Anh ngắn."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử lại"
          }
        }
      }
    },
    "Use": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng"
          }
        }
      }
    },
    "Use this model": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng model này"
          }
        }
      }
    },
    "Very fast hybrid models built for phones. English first: Vietnamese is basic.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model lai rất nhanh, làm cho điện thoại. Ưu tiên tiếng Anh: tiếng Việt ở mức cơ bản."
          }
        }
      }
    },
    "Waiting for Wi-Fi…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ Wi-Fi…"
          }
        }
      }
    }
  }
}