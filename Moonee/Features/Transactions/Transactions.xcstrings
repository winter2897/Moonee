    "Moonee remembers your category for next time.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເທື່ອໜ້າ Moonee ຈະຈື່ໝວດໝູ່ນີ້ໃຫ້ເອງ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครั้งหน้า Moonee จะจำหมวดหมู่นี้ให้เอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần sau Moonee sẽ tự nhớ danh mục này cho bạn."
          }
        }
      }
    },
