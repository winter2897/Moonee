    "Tap + and tell Moonee “lunch 45k” to log your first one.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຕະ + ແລ້ວບອກ Moonee ວ່າ “ເຝີ 30ພັນ” ເພື່ອບັນທຶກລາຍການທຳອິດ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ + แล้วบอก Moonee ว่า “ข้าวผัด 60” เพื่อจดรายการแรก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn + và nhắn Moonee “ăn trưa 45k” để ghi khoản đầu tiên nhé."
          }
        }
      }
    },
