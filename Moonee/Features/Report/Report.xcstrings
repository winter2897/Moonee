{
  "sourceLanguage": "en",
  "strings": {
    "%@ ended in the red: move %@ from %@ to cover it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọ %1$@ đang âm: chuyển %2$@ từ lọ %3$@ sang để bù nhé."
          }
        }
      }
    },
    "By category": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo danh mục"
          }
        }
      }
    },
    "Carried over to next month": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang tháng sau"
          }
        }
