{
  "sourceLanguage": "en",
  "strings": {
    "%@ ended in the red: move %@ from %@ to cover it.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກະປຸກ %@ ຕິດລົບ: ໂອນ %@ ຈາກ %@ ມາເຕີມເດີ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระปุก %@ ติดลบ: โอน %@ จาก %@ มาเติมนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọ %1$@ đang âm: chuyển %2$@ từ lọ %3$@ sang để bù nhé."
          }
        }
      }
    },
    "Avg %@": {
      "localizations": {
        "lo": {
          "stringUnit": {
