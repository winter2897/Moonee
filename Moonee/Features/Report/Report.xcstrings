    "Spending by jar, top expenses and Moonee's take": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍຈ່າຍຕາມກະປຸກ, ລາຍຈ່າຍກ້ອນໃຫຍ່ ແລະ ຄວາມເຫັນຈາກ Moonee"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายจ่ายตามกระปุก รายจ่ายก้อนใหญ่ และความเห็นจาก Moonee"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi theo lọ, khoản chi lớn nhất và nhận xét của Moonee"
          }
        }
      }
    },
    "Spending trend": {
      "localizations": {
