            "value": "Chưa phân loại"
          }
        }
      }
    },
    "Wrap up last month for me in two or three sentences.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສະຫຼຸບເດືອນແລ້ວໃຫ້ແດ່ ສັກສອງສາມປະໂຫຍກ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สรุปเดือนที่แล้วให้หน่อย สักสองสามประโยค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tóm tắt tháng trước giúp mình trong hai, ba câu nhé."
          }
        }
      }
    },
    "Wrap up this month for me in two or three sentences.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສະຫຼຸບເດືອນນີ້ໃຫ້ແດ່ ສັກສອງສາມປະໂຫຍກ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สรุปเดือนนี้ให้หน่อย สักสองสามประโยค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tóm tắt tháng này giúp mình trong hai, ba câu nhé."
          }
        }
      }
    },
    "You kept %@, %lld%% of your income.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຈົ້າເກັບໄດ້ %@ ຄິດເປັນ %lld%% ຂອງລາຍຮັບ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเก็บได้ %@ คิดเป็น %lld%% ของรายรับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn để dành được %1$@, bằng %2$lld%% thu nhập."
          }
        }
      }
    },
    "You spent %@, %lld%% less than the month before. Nice work!": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຈົ້າໃຊ້ໄປ %@ ໜ້ອຍກວ່າເດືອນກ່ອນໜ້າ %lld%% ເກັ່ງຫຼາຍ!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณใช้ไป %@ น้อยกว่าเดือนก่อนหน้า %lld%% เก่งมาก!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã chi %1$@, ít hơn tháng trước đó %2$lld%%. Giỏi lắm!"
          }
        }
      }
    },
    "You spent %@, %lld%% more than the month before.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຈົ້າໃຊ້ໄປ %@ ຫຼາຍກວ່າເດືອນກ່ອນໜ້າ %lld%%"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณใช้ไป %@ มากกว่าเดือนก่อนหน้า %lld%%"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã chi %1$@, nhiều hơn tháng trước đó %2$lld%%."
          }
        }
      }
    },
    "You spent %@.": {
      "localizations": {
        "lo": {
          "stringUnit": {
