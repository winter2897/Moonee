    },
    "No jar": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ມີກະປຸກ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีกระปุก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có lọ"
          }
        }
      }
    },
    "Nothing logged this month yet. Tell Moonee your first spend and the report fills itself in.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເດືອນນີ້ຍັງບໍ່ໄດ້ບັນທຶກຫຍັງເລີຍ ບອກ Moonee ລາຍຈ່າຍທຳອິດ ແລ້ວລາຍງານຈະຂຶ້ນມາເອງ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดือนนี้ยังไม่ได้จดอะไรเลย บอก Moonee รายจ่ายแรก แล้วรายงานจะขึ้นมาเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tháng này chưa có ghi chép nào. Kể Moonee khoản chi đầu tiên là báo cáo tự có ngay."
          }
        }
      }
    },
    "Previous month": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
