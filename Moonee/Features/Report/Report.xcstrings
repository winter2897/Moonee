    "Every jar's balance carries over to next month.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍອດເງິນຂອງທຸກກະປຸກຈະຍົກຍອດໄປເດືອນໜ້າ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดคงเหลือของทุกกระปุกจะยกยอดไปเดือนหน้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư các lọ được cộng dồn sang tháng sau."
          }
        }
      }
    },
    "Income": {
      "localizations": {
