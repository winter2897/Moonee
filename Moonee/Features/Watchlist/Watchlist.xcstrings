  "strings": {
    "Add asset": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tài sản"
          }
        }
      }
    },
    "Add gold, stocks, crypto or foreign currency with the price you know. Moonee adds them to your net worth.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vàng, cổ phiếu, crypto hay ngoại tệ với giá bạn biết. Moonee sẽ cộng vào tài sản ròng của bạn."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huỷ"
          }
        }
      }
    },
