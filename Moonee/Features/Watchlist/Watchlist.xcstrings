    "Moonee has no live prices yet: type the price you know, e.g. 2 taels of gold at today's price per tael.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee chưa có giá trực tiếp: hãy nhập giá bạn biết, ví dụ 2 lượng vàng với giá một lượng hôm nay."
          }
        }
      }
    },
