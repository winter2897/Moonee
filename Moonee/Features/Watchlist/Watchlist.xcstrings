    "Add asset": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມຊັບສິນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มสินทรัพย์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tài sản"
          }
        }
      }
    },
    "Add gold, stocks, crypto or foreign currency with the price you know. Moonee adds them to your net worth.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມຄຳ, ຮຸ້ນ, ຄຣິບໂຕ ຫຼື ເງິນຕາຕ່າງປະເທດ ດ້ວຍລາຄາທີ່ເຈົ້າຮູ້ Moonee ຈະລວມເຂົ້າໃນຊັບສິນສຸດທິໃຫ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มทอง หุ้น คริปโต หรือเงินตราต่างประเทศ ด้วยราคาที่คุณรู้ Moonee จะรวมเข้าในความมั่งคั่งสุทธิให้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vàng, cổ phiếu, crypto hay ngoại tệ với giá bạn biết. Moonee sẽ cộng vào tài sản ròng của bạn."
          }
        }
      }
    },
    "Add your first asset": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມຊັບສິນທຳອິດ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มสินทรัพย์แรก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tài sản đầu tiên"
          }
        }
      }
    },
