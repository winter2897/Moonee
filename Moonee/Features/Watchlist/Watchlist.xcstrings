    "No assets yet": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍັງບໍ່ມີຊັບສິນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสินทรัพย์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tài sản nào"
          }
        }
      }
    },
    "No live prices yet: type the price you know, e.g. 2 taels of gold at today's price per tael.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍັງບໍ່ມີລາຄາສົດ: ໃສ່ລາຄາທີ່ເຈົ້າຮູ້ ເຊັ່ນ ຄຳ 2 ບາດ ຕາມລາຄາຕໍ່ບາດຂອງມື້ນີ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีราคาสด: ใส่ราคาที่คุณรู้ เช่น ทอง 2 บาท ตามราคาต่อบาทของวันนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có giá trực tiếp: hãy nhập giá bạn biết, ví dụ 2 lượng vàng với giá một lượng hôm nay."
          }
        }
      }
    },
    "Not in net worth: priced in %@": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ລວມໃນຊັບສິນສຸດທິ: ລາຄາເປັນ %@"
