    "**Hi there!**\nWhat can Moonee do for you today? Log a spend, ask about your money, or snap a receipt.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "**ສະບາຍດີ!**\nມື້ນີ້ໃຫ້ Moonee ຊ່ວຍຫຍັງດີ? ຈົດລາຍຈ່າຍ, ຖາມເລື່ອງເງິນ ຫຼື ຖ່າຍຮູບໃບບິນຮັບເງິນມາກໍໄດ້ເດີ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**สวัสดี!**\nวันนี้ให้ Moonee ช่วยอะไรดี? จดรายจ่าย ถามเรื่องเงิน หรือถ่ายรูปใบเสร็จมาก็ได้นะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Chào bạn!**\nHôm nay Moonee giúp gì được cho bạn? Bạn có thể ghi chi tiêu, hỏi tình hình tài chính, hoặc chụp hoá đơn cho Moonee nhé."
          }
        }
      }
    },
    "Moonee logged all %lld for you.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ຈົດໃຫ້ຄົບທັງ %lld ລາຍການແລ້ວເດີ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee จดให้ครบทั้ง %lld รายการแล้วนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ghi lại đủ %lld khoản cho bạn rồi nhé."
          }
        }
      }
    },
    "Done, %lld transactions are in your books.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຮຽບຮ້ອຍ, %lld ລາຍການເຂົ້າບັນຊີແລ້ວ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียบร้อย %lld รายการเข้าบัญชีแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong, %lld giao dịch đã vào sổ rồi nè."
          }
        }
      }
    },
    "Moonee logged %lld transactions, **%@** in total.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ຈົດໄປ %lld ລາຍການ, ລວມທັງໝົດ **%@**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee จดไป %lld รายการ รวมทั้งหมด **%@**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ghi lại %1$lld khoản, tổng cộng **%2$@** rồi nhé."
          }
        }
      }
    },
    "All %lld are in: **%@** altogether.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄົບທັງ %lld ລາຍການ: ລວມເປັນ **%@** ເນາະ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครบทั้ง %lld รายการ รวมเป็น **%@** จ้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong cả %1$lld khoản, tổng **%2$@** nha."
          }
        }
      }
    },
    "Moonee noted **%@** for %@ %@.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ຈົດໃຫ້ແລ້ວ **%@** ໃຊ້ໄປກັບ%@ %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee จดให้แล้ว **%@** ใช้ไปกับ%@ %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ghi lại **%1$@** %2$@ %3$@ rồi nhé."
          }
        }
      }
    },
    "Got it, **%@** on %@ %@ is in your books.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄດ້ເລີຍ, **%@** ສຳລັບ%@ %@ ລົງບັນຊີແລ້ວ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้เลย **%@** สำหรับ%@ %@ ลงบัญชีแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ok nè, **%1$@** cho %2$@ %3$@ đã vào sổ."
          }
        }
      }
    },
    "Done! **%@** for %@ %@, all saved.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຮຽບຮ້ອຍ! **%@** ຄ່າ%@ %@, ບັນທຶກໄວ້ແລ້ວ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียบร้อย! **%@** ค่า%@ %@ บันทึกไว้แล้วจ้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong! **%1$@** cho %2$@ %3$@, Moonee lưu rồi đó."
          }
        }
      }
    },
    "Nice, **%@** came in from %@ %@.": {
