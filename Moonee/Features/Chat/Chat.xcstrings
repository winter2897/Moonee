      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm qua"
          }
        }
      }
    },
    "You only have one wallet so far. Add another in Budget, then tell Moonee again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn mới có một ví thôi. Thêm ví khác trong Ngân sách rồi nhắn lại Moonee nha."
          }
        }
      }
    },
    "You spent **%@** %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã chi **%@** %@."
