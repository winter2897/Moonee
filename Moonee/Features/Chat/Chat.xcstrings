    },
    "Moved **%@** from %@ to %@.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍ້າຍ **%@** ຈາກ %@ ໄປ %@ ແລ້ວ."
