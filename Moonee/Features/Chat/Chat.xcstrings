    },
    "Turn on Photos for Moonee in Settings to pick receipts here.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປີດສິດຮູບພາບໃຫ້ Moonee ໃນການຕັ້ງຄ່າ ເພື່ອເລືອກໃບບິນຮັບເງິນຈາກບ່ອນນີ້ໄດ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดสิทธิ์รูปภาพให้ Moonee ในการตั้งค่า เพื่อเลือกใบเสร็จจากตรงนี้ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền Ảnh cho Moonee trong Cài đặt để chọn hoá đơn ở đây."
          }
        }
      }
    },
    "This month you have **%@** left to spend of **%@** (spent **%@**).": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເດືອນນີ້ເຈົ້າຍັງໃຊ້ໄດ້ອີກ **%1$@** ຈາກທັງໝົດ **%2$@** (ໃຊ້ໄປແລ້ວ **%3$@**)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดือนนี้คุณยังใช้ได้อีก **%1$@** จากทั้งหมด **%2$@** (ใช้ไปแล้ว **%3$@**)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tháng này bạn còn **%1$@** để tiêu trên tổng **%2$@** (đã chi **%3$@**)."
          }
        }
      }
    },
    "After the bills still due: **%@**.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຫັກໃບບິນທີ່ຍັງຕ້ອງຈ່າຍແລ້ວ ເຫຼືອ **%@**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หักบิลที่ยังต้องจ่ายแล้ว เหลือ **%@**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trừ các hoá đơn sắp tới thì còn **%@**."
          }
        }
      }
    },
    "Next income: **%@** (%@) on %@.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍຮັບຖັດໄປ: **%1$@** (%2$@) ວັນທີ %3$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายรับถัดไป: **%1$@** (%2$@) วันที่ %3$@"
