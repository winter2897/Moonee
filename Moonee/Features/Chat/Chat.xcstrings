    "Put aside **%@** a week (**%@** a month) to reach %@ by %@.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເກັບອາທິດລະ **%@** (ເດືອນລະ **%@**) ກໍຈະຮອດ %@ ພາຍໃນ %@ ເດີ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บสัปดาห์ละ **%@** (เดือนละ **%@**) ก็จะถึง %@ ภายใน %@ นะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tuần để dành **%@** (mỗi tháng **%@**) là bạn đạt %@ trước ngày %@ nha!"
          }
        }
      }
    },
