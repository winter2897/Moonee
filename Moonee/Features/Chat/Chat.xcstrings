        }
      }
    },
    "Moved **%@** from the %@ jar to %@.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍ້າຍ **%@** ຈາກກະປຸກ %@ ໄປກະປຸກ %@ ແລ້ວເດີ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้าย **%@** จากกระปุก %@ ไปกระปุก %@ แล้วนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee chuyển **%1$@** từ lọ %2$@ sang lọ %3$@ rồi nha."
          }
        }
      }
    },
    "Noted, you lent out **%@**.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຈົດໄວ້ແລ້ວ, ເຈົ້າໃຫ້ຢືມໄປ **%@**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดไว้แล้ว คุณให้ยืมไป **%@**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ghi lại bạn cho mượn **%@** rồi nhé."
          }
        }
      }
    },
    "Noted, you lent %@ **%@**.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຈົດໄວ້ແລ້ວ, ເຈົ້າໃຫ້ %@ ຢືມ **%@**."
          }
        },
        "th": {
          "stringUnit": {
