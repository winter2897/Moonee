    },
    "Model: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model: %@"
          }
        }
      }
    },
    "Month-end saving tips": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý tiết kiệm cuối tháng"
          }
        }
      }
    },
    "Moonee couldn't read that photo 😵 Try again with the whole receipt in good light.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee chưa đọc được ảnh này 😵 Bạn chụp lại cả tờ hoá đơn, đủ sáng giúp Moonee nha."
          }
        }
      }
    },
    "New chat": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện mới"
          }
        }
      }
    },
    "No chats yet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có cuộc trò chuyện nào"
