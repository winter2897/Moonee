        }
      }
    },
    "Reference information, not investment advice." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຂໍ້ມູນເພື່ອອ້າງອີງ, ບໍ່ແມ່ນຄຳແນະນຳການລົງທຶນ."
