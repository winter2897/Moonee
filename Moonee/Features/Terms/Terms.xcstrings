{
  "sourceLanguage" : "en",
  "strings" : {
    "AI answers can be wrong. They only analyse the numbers you enter." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຄຳຕອບຂອງ AI ອາດຜິດໄດ້ ແລະ ວິເຄາະສະເພາະຕົວເລກທີ່ເຈົ້າປ້ອນເທົ່ານັ້ນ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำตอบของ AI อาจผิดได้ และวิเคราะห์เฉพาะตัวเลขที่คุณกรอกเท่านั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Câu trả lời của AI có thể sai. AI chỉ phân tích những con số bạn nhập."
          }
        }
      }
    },
