        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านข้อกำหนดฉบับเต็ม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc toàn bộ điều khoản"
