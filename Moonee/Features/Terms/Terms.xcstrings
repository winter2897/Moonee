        }
      }
    },
    "I am 18 or older and I agree to the Terms of Use and AI disclaimer." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຂ້ອຍມີອາຍຸ 18 ປີຂຶ້ນໄປ ແລະ ຍອມຮັບຂໍ້ກຳນົດການນຳໃຊ້ ແລະ ຂໍ້ຈຳກັດຄວາມຮັບຜິດຊອບກ່ຽວກັບ AI."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันอายุ 18 ปีขึ้นไป และยอมรับข้อกำหนดการใช้งานและข้อจำกัดความรับผิดชอบเรื่อง AI"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi từ 18 tuổi trở lên và đồng ý với Điều khoản sử dụng và miễn trừ trách nhiệm về AI."
          }
        }
      }
    },
    "Moonee is a record-keeping and budgeting tool, not a financial, investment, tax or legal adviser." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ແມ່ນເຄື່ອງມືບັນທຶກ ແລະ ວາງງົບ, ບໍ່ແມ່ນທີ່ປຶກສາດ້ານການເງິນ, ການລົງທຶນ, ພາສີ ຫຼື ກົດໝາຍ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee เป็นเครื่องมือจดบันทึกและวางงบ ไม่ใช่ที่ปรึกษาด้านการเงิน การลงทุน ภาษี หรือกฎหมาย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee là công cụ ghi chép và lập ngân sách, không phải chuyên gia tư vấn tài chính, đầu tư, thuế hay pháp lý."
          }
        }
      }
    },
    "Moonee never tells you to buy, sell or hold stocks, crypto, gold or currencies, and never predicts prices." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ບໍ່ແນະນຳໃຫ້ຊື້, ຂາຍ ຫຼື ຖືຮຸ້ນ, ຄຣິບໂຕ, ຄຳ ຫຼື ເງິນຕາຕ່າງປະເທດ, ແລະ ບໍ່ທຳນາຍລາຄາ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ไม่แนะนำให้ซื้อ ขาย หรือถือหุ้น คริปโต ทองคำ หรือเงินตราต่างประเทศ และไม่ทำนายราคา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee không bao giờ khuyên bạn mua, bán hay giữ cổ phiếu, crypto, vàng hay ngoại tệ, và không dự đoán giá."
          }
        }
      }
    },
    "Please read and accept these points to use Moonee." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ອ່ານ ແລະ ຍອມຮັບຂໍ້ຕໍ່ໄປນີ້ເພື່ອໃຊ້ Moonee ເດີ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านและยอมรับข้อต่อไปนี้เพื่อใช้ Moonee นะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đọc và đồng ý những điểm dưới đây để dùng Moonee nhé."
          }
        }
      }
    },
    "Read the full terms" : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ອ່ານຂໍ້ກຳນົດສະບັບເຕັມ"
