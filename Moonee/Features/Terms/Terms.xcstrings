    },
    "You accepted version %lld on %@." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຈົ້າຍອມຮັບສະບັບທີ %1$lld ເມື່ອ %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณยอมรับฉบับที่ %1$lld เมื่อ %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã đồng ý phiên bản %1$lld ngày %2$@."
          }
        }
      }
    },
    "Your data stays on this iPhone and your iCloud. With your own AI key, messages go to the provider you chose." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຂໍ້ມູນຢູ່ໃນ iPhone ເຄື່ອງນີ້ ແລະ iCloud ຂອງເຈົ້າ. ຖ້າໃຊ້ກະແຈ AI ຂອງເຈົ້າເອງ, ຂໍ້ຄວາມຈະສົ່ງໄປຫາຜູ້ໃຫ້ບໍລິການທີ່ເຈົ້າເລືອກ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลอยู่บน iPhone เครื่องนี้และ iCloud ของคุณ หากใช้คีย์ AI ของคุณเอง ข้อความจะส่งไปยังผู้ให้บริการที่คุณเลือก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu nằm trên iPhone này và iCloud của bạn. Khi dùng khoá AI riêng, tin nhắn được gửi tới nhà cung cấp bạn chọn."
          }
        }
      }
    },
    "Your money decisions are yours alone. The app maker, AI model makers and AI providers are not liable for them." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຕັດສິນໃຈເລື່ອງເງິນເປັນຂອງເຈົ້າຜູ້ດຽວ. ຜູ້ພັດທະນາແອັບ, ຜູ້ສ້າງໂມເດລ AI ແລະ ຜູ້ໃຫ້ບໍລິການ AI ບໍ່ຕ້ອງຮັບຜິດຕໍ່ການຕັດສິນໃຈນັ້ນ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตัดสินใจเรื่องเงินเป็นของคุณคนเดียว ผู้พัฒนาแอป ผู้สร้างโมเดล AI และผู้ให้บริการ AI ไม่ต้องรับผิดต่อการตัดสินใจนั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyết định về tiền bạc là của riêng bạn. Nhà phát triển app, bên làm mô hình AI và nhà cung cấp AI không chịu trách nhiệm về các quyết định đó."
          }
        }
      }
    }
  },
  "version" : "1.0"
