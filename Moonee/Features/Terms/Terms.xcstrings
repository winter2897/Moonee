    "We updated our terms" : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ພວກເຮົາປັບປຸງຂໍ້ກຳນົດແລ້ວ"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราปรับปรุงข้อกำหนดแล้ว"
