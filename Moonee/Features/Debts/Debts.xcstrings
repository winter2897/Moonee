      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xong (%lld)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคลียร์แล้ว (%lld)"
