          "stringUnit": {
            "state": "translated",
            "value": "ເຫຼືອຫຼັງຈາກນີ້: %@"
          }
        }
      }
    },
    "Lent in total": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng đã cho mượn"
          }
        },
