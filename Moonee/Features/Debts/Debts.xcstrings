    },
    "Mark settled": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu đã xong"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายว่าเคลียร์แล้ว"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໝາຍວ່າສະສາງແລ້ວ"
          }
        }
      }
    },
    "Moonee reminds you on the due day.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee sẽ nhắc bạn vào ngày tới hạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee จะเตือนคุณในวันครบกำหนด"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ຈະເຕືອນທ່ານໃນມື້ຄົບກຳນົດ."
          }
        }
      }
    },
    "No debts yet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có khoản nợ nào"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีหนี้"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍັງບໍ່ມີໜີ້"
          }
        }
      }
    },
    "No due date": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thời hạn"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีกำหนด"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ມີກຳນົດ"
          }
        }
      }
    },
    "No due date: Moonee checks in every couple of weeks.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thời hạn: cứ hai tuần Moonee nhắc nhẹ một lần."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีกำหนด: Moonee จะเตือนเบาๆ ทุกสองสัปดาห์"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ມີກຳນົດ: Moonee ຈະເຕືອນເບົາໆທຸກສອງອາທິດ."
          }
        }
      }
    },
    "No open debts": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có khoản nợ nào"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีหนี้ค้าง"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ມີໜີ້ຄ້າງ"
          }
        }
      }
    },
    "Overdue · %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá hạn · %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลยกำหนด · %@"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກາຍກຳນົດ · %@"
          }
        }
      }
    },
    "Paid back in full (%@)": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã trả đủ (%@)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนครบแล้ว (%@)"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສົ່ງຄືນຄົບແລ້ວ (%@)"
          }
        }
      }
    },
    "Paid back records the money in your wallet. Closing without payment just ends the debt.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã trả đủ sẽ ghi tiền vào ví. Đóng không ghi tiền chỉ kết thúc khoản nợ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนครบแล้วจะบันทึกเงินในกระเป๋า ปิดโดยไม่บันทึกการคืนเงินจะแค่จบหนี้นี้"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສົ່ງຄືນຄົບແລ້ວຈະບັນທຶກເງິນໃນກະເປົາ. ປິດໂດຍບໍ່ບັນທຶກແມ່ນພຽງແຕ່ຈົບໜີ້ນີ້."
          }
        }
      }
    },
    "Pay %@ back %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả %1$@ %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนเงิน %1$@ %2$@"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສົ່ງເງິນຄືນ %1$@ %2$@"
          }
        }
      }
    },
    "Pay back by": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả trước ngày"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนภายใน"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສົ່ງຄືນພາຍໃນ"
          }
        }
      }
    },
