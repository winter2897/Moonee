{
  "sourceLanguage": "en",
  "strings": {
    "%@ has used %lld%% of this month. Go easy for now!": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã dùng %2$lld%% của tháng này. Chậm lại chút nhé!"
          }
        }
      }
    },
    "%@ is due in %lld days.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đến hạn sau %2$lld ngày nữa."
          }
        }
      }
    },
    "%@ is due today.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đến hạn hôm nay."
          }
        }
      }
    },
    "%@ is due tomorrow.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đến hạn ngày mai."
          }
        }
      }
    },
    "%@ is in the red. Move some money in from another jar?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọ %@ đang âm. Chuyển bớt tiền từ lọ khác sang nhé?"
          }
        }
      }
    },
    "%@ is over this month's budget. Let's slow down a little.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọ %@ đã vượt ngân sách tháng này. Mình chi chậm lại chút nhé."
          }
        }
      }
    },
    "%@ is overdue. Pay it soon to avoid fees.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã quá hạn. Trả sớm để khỏi bị phạt nhé."
          }
        }
      }
    },
    "%@ report": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo %@"
          }
        }
      }
    },
    "All transactions": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả giao dịch"
          }
        }
      }
    },
    "Avg %@: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TB %1$@: %2$@"
          }
        }
      }
    },
    "Big number: what is left in the jar. Bar: spent this month out of what the jar had for the month.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lớn: tiền còn lại trong lọ. Thanh: đã chi tháng này trên số tiền lọ có trong tháng."
          }
        }
      }
    },
    "Bills due in 7 days": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoá đơn đến hạn trong 7 ngày"
          }
        }
      }
    },
    "Changes compared with last month.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi so với tháng trước."
