          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu nhập"
          }
        }
      }
    },
    "Income and expenses this month, compared with last month.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍຮັບ ແລະ ລາຍຈ່າຍເດືອນນີ້ ທຽບກັບເດືອນແລ້ວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายรับและรายจ่ายเดือนนี้ เทียบกับเดือนที่แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu và chi tháng này, so với tháng trước."
          }
        }
      }
    },
    "Income and expenses this week, compared with last week.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍຮັບ ແລະ ລາຍຈ່າຍອາທິດນີ້ ທຽບກັບອາທິດແລ້ວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายรับและรายจ่ายสัปดาห์นี้ เทียบกับสัปดาห์ที่แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu và chi tuần này, so với tuần trước."
          }
        }
      }
    },
    "Income and expenses this year, compared with last year.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍຮັບ ແລະ ລາຍຈ່າຍປີນີ້ ທຽບກັບປີກາຍ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายรับและรายจ่ายปีนี้ เทียบกับปีที่แล้ว"
