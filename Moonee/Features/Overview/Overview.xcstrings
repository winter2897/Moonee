{
  "sourceLanguage": "en",
  "strings": {
    "%@ has used %lld%% of this month. Go easy for now!": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກະປຸກ %@ ໃຊ້ໄປແລ້ວ %lld%% ຂອງເດືອນນີ້ ຄ່ອຍໆ ໃຊ້ເດີ!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระปุก %@ ใช้ไปแล้ว %lld%% ของเดือนนี้ ค่อยๆ ใช้นะ!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã dùng %2$lld%% của tháng này. Chậm lại chút nhé!"
          }
        }
      }
    },
    "%@ is due in %lld days.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ຈະຄົບກຳນົດໃນອີກ %lld ມື້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะครบกำหนดในอีก %lld วัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đến hạn sau %2$lld ngày nữa."
          }
        }
      }
    },
    "%@ is due today.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ຄົບກຳນົດມື້ນີ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ครบกำหนดวันนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đến hạn hôm nay."
          }
        }
      }
    },
    "%@ is due tomorrow.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ຄົບກຳນົດມື້ອື່ນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ครบกำหนดพรุ่งนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đến hạn ngày mai."
          }
        }
      }
    },
    "%@ is in the red. Move some money in from another jar?": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກະປຸກ %@ ຕິດລົບແລ້ວ ໂອນເງິນຈາກກະປຸກອື່ນມາເຕີມບໍ?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระปุก %@ ติดลบแล้ว โอนเงินจากกระปุกอื่นมาเติมไหม?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọ %@ đang âm. Chuyển bớt tiền từ lọ khác sang nhé?"
          }
        }
      }
    },
    "%@ is over this month's budget. Let's slow down a little.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກະປຸກ %@ ເກີນງົບປະມານເດືອນນີ້ແລ້ວ ໃຊ້ຊ້າລົງແດ່ເດີ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระปุก %@ เกินงบเดือนนี้แล้ว ใช้ช้าลงหน่อยนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọ %@ đã vượt ngân sách tháng này. Mình chi chậm lại chút nhé."
          }
        }
      }
    },
    "%@ is overdue. Pay it soon to avoid fees.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ກາຍກຳນົດແລ້ວ ຮີບຈ່າຍຈະໄດ້ບໍ່ຖືກຄ່າປັບ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เลยกำหนดแล้ว รีบจ่ายจะได้ไม่โดนค่าปรับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã quá hạn. Trả sớm để khỏi bị phạt nhé."
          }
        }
      }
    },
    "%@ report": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍງານ %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงาน %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo %@"
          }
        }
      }
    },
    "All transactions": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍການທັງໝົດ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการทั้งหมด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả giao dịch"
          }
        }
      }
    },
    "Avg %@: %@": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສະເລ່ຍ%@: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉลี่ย%@: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TB %1$@: %2$@"
          }
        }
      }
    },
    "Big number: what is left in the jar. Bar: spent this month out of what the jar had for the month.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕົວເລກໃຫຍ່: ເງິນທີ່ເຫຼືອໃນກະປຸກ ແຖບ: ຍອດທີ່ໃຊ້ເດືອນນີ້ ທຽບກັບເງິນທີ່ກະປຸກມີໃນເດືອນນີ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขใหญ่: เงินที่เหลือในกระปุก แถบ: ยอดที่ใช้เดือนนี้ เทียบกับเงินที่กระปุกมีในเดือนนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lớn: tiền còn lại trong lọ. Thanh: đã chi tháng này trên số tiền lọ có trong tháng."
          }
        }
      }
    },
    "Bills due in 7 days": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃບບິນທີ່ຄົບກຳນົດໃນ 7 ມື້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บิลที่ครบกำหนดใน 7 วัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoá đơn đến hạn trong 7 ngày"
          }
        }
      }
    },
