        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ຈາກເງິນທີ່ຍັງບໍ່ແບ່ງ ເຂົ້າ %@"
          }
        }
      }
    },
    "%@ has used 80%% of this month's budget. Go easy for a bit!" : {
      "extractionState" : "manual",
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ກະປຸກ %@ ໃຊ້ໄປແລ້ວ 80%% ຂອງງົບເດືອນນີ້. ໄລຍະນີ້ໃຊ້ເບົາໆ ແດ່ເດີ!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กระปุก %@ ใช้ไปแล้ว 80%% ของงบเดือนนี้ ช่วงนี้ใช้เบาๆ หน่อยนะ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã dùng 80%% ngân sách tháng này. Chậm lại chút nha!"
          }
        }
      }
    },
    "%@ is %@ below zero" : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ຕິດລົບ %@"
