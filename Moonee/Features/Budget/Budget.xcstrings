    "Bills due and jars over 100%.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃບບິນທີ່ຄົບກຳນົດ ແລະ ກະປຸກທີ່ໃຊ້ເກີນ 100%."
