          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để chuyển tiền từ lọ %@."
          }
        }
      }
    },
    "Tell Moonee what you spent today, it takes a few seconds.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບອກ Moonee ແດ່ວ່າມື້ນີ້ໃຊ້ຫຍັງໄປແດ່, ແປັບດຽວກໍແລ້ວ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอก Moonee หน่อยว่าวันนี้ใช้อะไรไปบ้าง แป๊บเดียวเสร็จ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kể Moonee nghe hôm nay bạn chi gì nha, chỉ vài giây thôi."
          }
        }
      }
    },
    "This bill is an estimate. Enter what you actually paid.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃບບິນນີ້ເປັນຍອດປະມານ. ໃສ່ຍອດທີ່ເຈົ້າຈ່າຍແທ້ເດີ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บิลนี้เป็นยอดประมาณ ใส่ยอดที่คุณจ่ายจริงนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là số ước tính. Nhập số tiền bạn đã trả thật nhé."
          }
        }
      }
    },
    "This jar is over. Move money from another jar to balance it.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກະປຸກນີ້ໃຊ້ເກີນແລ້ວ. ຍ້າຍເງິນຈາກກະປຸກອື່ນມາເຕີມໃຫ້ພໍດີເດີ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระปุกนี้ใช้เกินแล้ว ย้ายเงินจากกระปุกอื่นมาเติมให้พอดีนะ"
          }
