        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đến hạn %@"
          }
        }
      }
    },
    "%@ is due soon. Tap Mark paid in Budget once it's done." : {
      "extractionState" : "manual",
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ໃກ້ຄົບກຳນົດແລ້ວ. ຈ່າຍສຳເລັດແລ້ວ ແຕະ “ຈ່າຍແລ້ວ” ໃນໜ້າງົບປະມານໄດ້ເລີຍ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ใกล้ครบกำหนดแล้ว จ่ายเสร็จแล้วแตะ “จ่ายแล้ว” ในหน้างบได้เลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sắp đến hạn. Trả xong thì bấm \"Đánh dấu đã trả\" trong Ngân sách nha."
          }
        }
      }
    },
    "%@ is due to pay you back %@ today. A gentle nudge?" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay %1$@ hẹn trả bạn %2$@. Nhắc nhẹ nhé?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้ %1$@ นัดคืนเงินคุณ %2$@ ทวงเบาๆ ไหม?"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ມື້ນີ້ %1$@ ນັດສົ່ງເງິນຄືນທ່ານ %2$@. ເຕືອນເບົາໆບໍ?"
          }
        }
      }
    },
    "%@ is going fast" : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ໃຊ້ໄປໄວຫຼາຍ"
