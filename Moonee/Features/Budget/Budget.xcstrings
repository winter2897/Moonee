{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ closed under budget!": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ປິດເດືອນໄດ້ບໍ່ເກີນງົບ!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ปิดเดือนได้ไม่เกินงบ!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ khép lại trong ngân sách!"
          }
        }
      }
    },
    "%@ has used 80%% of this month's budget. Go easy for a bit!": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກະປຸກ %@ ໃຊ້ໄປແລ້ວ 80%% ຂອງງົບເດືອນນີ້. ໄລຍະນີ້ໃຊ້ເບົາໆ ແດ່ເດີ!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระปุก %@ ใช้ไปแล้ว 80%% ของงบเดือนนี้ ช่วงนี้ใช้เบาๆ หน่อยนะ!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã dùng 80%% ngân sách tháng này. Chậm lại chút nha!"
          }
        }
      }
    },
    "%@ is below zero": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກະປຸກ %@ ຕິດລົບ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระปุก %@ ติดลบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọ %@ đang âm"
          }
        }
      }
    },
    "%@ is due soon. Tap Mark paid in Budget once it's done.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ໃກ້ຄົບກຳນົດແລ້ວ. ຈ່າຍສຳເລັດແລ້ວ ແຕະ “ຈ່າຍແລ້ວ” ໃນໜ້າງົບປະມານໄດ້ເລີຍ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใกล้ครบกำหนดแล้ว จ่ายเสร็จแล้วแตะ “จ่ายแล้ว” ในหน้างบได้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sắp đến hạn. Trả xong thì bấm \"Đánh dấu đã trả\" trong Ngân sách nha."
          }
        }
      }
    },
    "%@ went past this month's budget. Moonee can help you move money from another jar.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກະປຸກ %@ ໃຊ້ເກີນງົບເດືອນນີ້ແລ້ວ. ໃຫ້ Moonee ຊ່ວຍຍ້າຍເງິນຈາກກະປຸກອື່ນໄດ້ເດີ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระปุก %@ ใช้เกินงบเดือนนี้แล้ว ให้ Moonee ช่วยย้ายเงินจากกระปุกอื่นได้นะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã vượt ngân sách tháng này. Moonee giúp bạn chuyển tiền từ lọ khác nha."
          }
        }
      }
    },
    "%@ → %@": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@"
          }
        }
      }
    },
    "%lld%% of each income": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% ຂອງທຸກລາຍຮັບ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% ของทุกรายรับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% mỗi khoản thu"
          }
        }
      }
    },
    "%lld%% spent": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃຊ້ໄປ %lld%%"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไป %lld%%"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chi %lld%%"
          }
        }
      }
    },
    "A jar went over": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມີກະປຸກໃຊ້ເກີນງົບ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีกระปุกใช้เกินงบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có lọ vượt ngân sách"
          }
        }
      }
    },
    "Add": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm"
          }
        }
      }
    },
    "Add bill": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມໃບບິນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มบิล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hoá đơn"
          }
        }
      }
    },
    "Add cash, a bank account, an e-wallet or a credit card.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມເງິນສົດ, ບັນຊີທະນາຄານ, ກະເປົາເງິນອອນລາຍ ຫຼື ບັດເຄຣດິດ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเงินสด บัญชีธนาคาร อีวอลเล็ต หรือบัตรเครดิต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tiền mặt, tài khoản ngân hàng, ví điện tử hoặc thẻ tín dụng."
          }
        }
      }
    },
    "Add jar": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມກະປຸກ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มกระปุก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm lọ mới"
          }
        }
      }
    },
    "Add rent, electricity, internet or subscriptions and Moonee will remind you before they're due.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມຄ່າເຊົ່າ, ຄ່າໄຟ, ຄ່າອິນເຕີເນັດ ຫຼື ຄ່າສະມາຊິກຕ່າງໆ ແລ້ວ Moonee ຈະເຕືອນເຈົ້າກ່ອນຄົບກຳນົດ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มค่าเช่า ค่าไฟ ค่าเน็ต หรือค่าสมาชิกรายเดือน แล้ว Moonee จะเตือนก่อนถึงกำหนด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tiền nhà, điện, internet hay các gói đăng ký, Moonee sẽ nhắc bạn trước hạn."
          }
        }
      }
    },
    "Add wallet": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມກະເປົາເງິນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มกระเป๋าเงิน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ví"
          }
        }
      }
    },
    "Added this month": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຕີມເຂົ້າເດືອນນີ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เติมเข้าเดือนนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia vào tháng này"
          }
        }
      }
    },
    "Amount": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຈຳນວນເງິນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเงิน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền"
          }
        }
      }
    },
    "Amount varies (estimate)": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຈຳນວນບໍ່ແນ່ນອນ (ປະມານ)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนไม่แน่นอน (ประมาณการ)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền thay đổi (ước tính)"
          }
        }
      }
    },
    "Anything to log today?": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມື້ນີ້ມີຫຍັງຕ້ອງຈົດບໍ່?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้มีอะไรต้องจดไหม?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay có gì cần ghi không?"
          }
        }
      }
    },
    "Assign categories to jars": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຈັດໝວດໝູ່ເຂົ້າກະປຸກ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดหมวดหมู่เข้ากระปุก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gán danh mục vào lọ"
          }
        }
      }
    },
    "At most %lld a day. Alerts of the same kind are grouped.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ເກີນມື້ລະ %lld ເທື່ອ. ການແຈ້ງເຕືອນປະເພດດຽວກັນຈະຖືກລວມໄວ້ນຳກັນ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เกินวันละ %lld ครั้ง การแจ้งเตือนประเภทเดียวกันจะรวมไว้ด้วยกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa %lld thông báo mỗi ngày. Các cảnh báo cùng loại được gộp lại."
          }
        }
      }
    },
