          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ຕິດລົບ: ເຕີມຈາກເງິນກ້ອນນີ້ໄດ້ເລີຍ"
          }
        }
      }
    },
    "%@ is due %@" : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ຄົບກຳນົດ %@"
