    "%@ stays unallocated to back what the jars already hold." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ເກັບໄວ້ບໍ່ແບ່ງ ເພື່ອຮອງຮັບເງິນທີ່ກະປຸກຖືຢູ່ແລ້ວ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เก็บไว้ไม่แบ่ง เพื่อรองรับเงินที่กระปุกถืออยู่แล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ để lại chưa chia, bù cho số các lọ đang giữ."
          }
        }
      }
    },
    "%@ still owes you %@. A gentle reminder?" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vẫn còn nợ bạn %2$@, nhắc nhẹ nhé?"
