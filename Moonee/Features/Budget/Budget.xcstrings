  "strings" : {
    "%@ %@ in yet?" : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ ເຂົ້າແລ້ວບໍ?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ เข้าหรือยัง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ về chưa?"
          }
        }
      }
    },
    "%@ builds your emergency fund toward %@, %lld months of essentials." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ສະສົມກອງທຶນສຸກເສີນໃຫ້ຮອດ %@, ເທົ່າກັບລາຍຈ່າຍຈຳເປັນ %lld ເດືອນ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ สะสมกองทุนฉุกเฉินให้ถึง %@ เท่ากับค่าใช้จ่ายจำเป็น %lld เดือน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ xây quỹ khẩn cấp tới %@, bằng %lld tháng chi tiêu thiết yếu."
          }
        }
      }
    },
    "%@ closed under budget!" : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ປິດເດືອນໄດ້ບໍ່ເກີນງົບ!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ปิดเดือนได้ไม่เกินงบ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ khép lại trong ngân sách!"
          }
        }
      }
    },
    "%@ covers %@ of bills and %@ of everyday needs until %@." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ພໍສຳລັບໃບບິນ %@ ແລະ ລາຍຈ່າຍຈຳເປັນ %@ ຈົນຮອດ %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ พอสำหรับบิล %@ และค่าใช้จ่ายจำเป็น %@ จนถึง %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đủ cho %@ hoá đơn và %@ chi tiêu thiết yếu đến %@."
          }
        }
      }
    },
