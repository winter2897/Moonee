        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang âm %@"
          }
        }
      }
    },
    "%@ is %@ below zero, and your budget wallets hold %@." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ຕິດລົບ %@, ແລະ ກະເປົາເງິນໃນງົບມີຢູ່ %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ติดลบ %@ และกระเป๋าเงินในงบมีอยู่ %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang âm %@, mà các ví ngân sách chỉ có %@."
          }
