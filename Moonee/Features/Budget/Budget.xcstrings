    "Swiping the card is spending (it comes out of a jar); paying the card is a transfer.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຮູດບັດແມ່ນການໃຊ້ຈ່າຍ (ຫັກຈາກກະປຸກ); ສ່ວນຈ່າຍບັດແມ່ນການໂອນ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูดบัตรคือการใช้จ่าย (หักจากกระปุก) ส่วนจ่ายบัตรคือการโอน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quẹt thẻ là chi tiêu (trừ vào lọ); trả nợ thẻ là chuyển ví."
          }
        }
      }
    },
    "Tap to move money from %@.": {
      "extractionState": "manual",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຕະເພື່ອຍ້າຍເງິນຈາກກະປຸກ %@."
          }
        },
        "th": {
          "stringUnit": {
