    },
    "Moonee records %@ today. Open Moonee to check it or undo." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ບັນທຶກ %@ ມື້ນີ້. ເປີດ Moonee ເພື່ອກວດ ຫຼື ຍົກເລີກ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee บันทึก %@ วันนี้ เปิด Moonee เพื่อตรวจดูหรือยกเลิก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ghi %@ hôm nay. Mở Moonee để xem hoặc hoàn tác."
          }
        }
      }
    },
    "Moonee records it on the due day, today included. You can undo it." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ບັນທຶກໃຫ້ໃນວັນຮອດກຳນົດ ລວມທັງມື້ນີ້. ທ່ານຍົກເລີກໄດ້."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee บันทึกให้ในวันครบกำหนด รวมถึงวันนี้ และยกเลิกได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee tự ghi vào ngày đến hạn, kể cả hôm nay. Bạn có thể hoàn tác."
          }
        }
      }
    },
    "Moonee records the difference as one “Balance adjustment”: it changes this wallet only and isn't counted as income or spending." : {
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ຈະບັນທຶກສ່ວນຕ່າງເປັນ “ປັບຍອດເງິນ” ໜຶ່ງລາຍການ: ປ່ຽນແຕ່ຍອດຂອງກະເປົາເງິນນີ້ ແລະ ບໍ່ນັບເປັນລາຍຮັບ ຫຼື ລາຍຈ່າຍ"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee จะบันทึกส่วนต่างเป็น “ปรับยอดเงิน” หนึ่งรายการ: เปลี่ยนแค่ยอดของกระเป๋าเงินนี้ และไม่นับเป็นรายรับหรือรายจ่าย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ghi phần chênh thành một khoản “Điều chỉnh số dư”: chỉ đổi số dư ví này, không tính vào thu hay chi."
          }
        }
      }
    },
    "Moonee records your salary on payday and splits money by its plan, then tells you. You can undo." : {
      "extractionState" : "manual",
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ບັນທຶກເງິນເດືອນໃນມື້ເງິນເດືອນອອກ ແລະ ແບ່ງເງິນຕາມແຜນ, ແລ້ວບອກເຈົ້າ. ຍົກເລີກໄດ້."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee บันทึกเงินเดือนในวันเงินเดือนออกและแบ่งเงินตามแผน แล้วบอกคุณ ยกเลิกได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee tự ghi lương vào ngày nhận và chia tiền theo kế hoạch, rồi báo bạn. Bạn có thể hoàn tác."
          }
        }
      }
    },
    "Moonee reminds you with local notifications. Nothing leaves your phone." : {
      "extractionState" : "manual",
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ເຕືອນຜ່ານການແຈ້ງເຕືອນໃນເຄື່ອງ. ບໍ່ມີຂໍ້ມູນໃດອອກຈາກໂທລະສັບຂອງເຈົ້າ."
