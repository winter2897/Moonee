    "Moonee moved your money" : {
      "extractionState" : "manual",
      "localizations" : {
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonee ຍ້າຍເງິນໃຫ້ແລ້ວ"
