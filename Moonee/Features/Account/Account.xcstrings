      }
    },
    "Share Moonee": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ Moonee"
          }
        }
      }
    },
    "Sign in to iCloud (or turn on iCloud for Moonee) in the Settings app to sync. Until then your data stays on this iPhone.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập iCloud (hoặc bật iCloud cho Moonee) trong ứng dụng Cài đặt để đồng bộ. Trong lúc đó dữ liệu vẫn nằm trên iPhone này."
          }
        }
      }
    },
    "Skills": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kỹ năng"
          }
        }
      }
    },
    "Spending coach": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huấn luyện chi tiêu"
          }
        }
      }
    },
    "Splitting income and balancing jars.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia thu nhập và cân đối các lọ."
          }
        }
      }
    },
    "Stored on this device only": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lưu trên máy này"
          }
        }
      }
    },
    "Stored on this device only · No account needed": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lưu trên máy · Không cần tài khoản"
          }
        }
      }
    },
    "Support & about": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỗ trợ & giới thiệu"
          }
        }
      }
    },
    "Test connection": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra kết nối"
          }
        }
      }
    },
    "Test key": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra key"
          }
        }
      }
    },
    "Thanks": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn"
          }
        }
      }
    },
    "The key is kept in this iPhone's Keychain. You pay your provider directly.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Key được lưu trong Keychain của iPhone này. Bạn trả phí trực tiếp cho nhà cung cấp."
          }
        }
      }
    },
    "The on-device model is not ready": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model trên máy chưa sẵn sàng"
          }
        }
      }
    },
    "The provider rejected this key. Check it and try again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp từ chối key này. Kiểm tra lại rồi thử lần nữa."
          }
        }
      }
    },
    "This iPhone does not support Apple Intelligence": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone này không hỗ trợ Apple Intelligence"
          }
        }
      }
    },
    "This server has no model list. Type a model ID instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Server này không có danh sách model. Hãy nhập ID model."
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ"
          }
        }
      }
    },
    "Transactions are read on this iPhone; advice and reports use your cloud key.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch được đọc trên iPhone này; tư vấn và báo cáo dùng key cloud của bạn."
          }
        }
      }
    },
    "Turn on Apple Intelligence in Settings": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật Apple Intelligence trong Cài đặt"
          }
        }
      }
    },
    "Turn on the app lock": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật khoá ứng dụng"
          }
        }
      }
    },
    "Type a model ID": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập ID model"
          }
        }
      }
    },
    "Typed transactions stay on this iPhone. For questions, advice and reports, your message, the chat so far and the numbers Moonee looks up are sent to %@ with your key. Moonee has no server.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch bạn gõ ở lại trên iPhone này. Với câu hỏi, tư vấn và báo cáo, tin nhắn của bạn, đoạn chat trước đó và số liệu Moonee tra được gửi tới %@ bằng key của bạn. Moonee không có server."
          }
        }
      }
    },
    "Unlock Moonee": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khoá Moonee"
          }
        }
      }
    },
    "Unlock with %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khoá bằng %@"
          }
        }
      }
    },
    "Use": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng"
          }
        }
      }
    },
    "Used for new transactions and for amounts like “45k”. Amounts already saved keep their currency.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cho giao dịch mới và cách hiểu số tiền như “45k”. Số tiền đã lưu giữ nguyên tiền tệ."
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản %@"
          }
        }
      }
    },
    "Wallets": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví"
          }
        }
      }
    },
    "What leaves this iPhone": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu nào rời khỏi iPhone"
          }
        }
      }
    },
    "Your API key": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "API key của bạn"
          }
        }
      }
    },
    "Your API key (BYOK)": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "API key của bạn (BYOK)"
          }
        }
      }
    },
    "Your data is stored on this iPhone only.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu chỉ được lưu trên iPhone này."
          }
        }
      }
    },
    "Your data syncs to your own private iCloud, so a new iPhone or a reinstall gets it back. Nobody else, Moonee included, can read it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu được đồng bộ vào iCloud riêng của bạn, nên iPhone mới hay khi cài lại vẫn có lại dữ liệu. Không ai khác, kể cả Moonee, đọc được."
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên của bạn"
          }
        }
      }
    },
    "iCloud is not available right now. Your data is safe on this iPhone and syncs when iCloud is back.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hiện không dùng được. Dữ liệu vẫn an toàn trên iPhone này và sẽ đồng bộ khi iCloud hoạt động lại."
          }
        }
      }
    },
    "iCloud sync": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ iCloud"
          }
        }
      }
    },
    "iOS is still downloading the model, try again later": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS đang tải model, thử lại sau"
          }
        }
      }
    }
  },
  "version": "1.0"
}
