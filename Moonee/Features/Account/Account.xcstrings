          }
        }
      }
    },
    "Share Moonee": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແບ່ງປັນ Moonee"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ Moonee"
          }
        },
        "vi": {
