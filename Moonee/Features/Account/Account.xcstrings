    },
    "Removes every transaction, wallet, jar, goal and setting from this iPhone. This cannot be undone.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລຶບທຸກລາຍການ, ກະເປົາເງິນ, ກະປຸກ, ເປົ້າໝາຍ ແລະ ການຕັ້ງຄ່າທັງໝົດອອກຈາກ iPhone ເຄື່ອງນີ້. ກູ້ຄືນບໍ່ໄດ້ເດີ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบทุกรายการ กระเป๋าเงิน กระปุก เป้าหมาย และการตั้งค่าทั้งหมดออกจาก iPhone เครื่องนี้ ย้อนกลับไม่ได้นะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá mọi giao dịch, ví, lọ, mục tiêu và cài đặt khỏi iPhone này. Không thể hoàn tác."
          }
        }
      }
    },
    "Same as iPhone": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕາມພາສາຂອງ iPhone"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตามภาษาของ iPhone"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giống iPhone"
          }
        }
      }
    },
    "Search models": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຊອກຫາໂມເດວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
