    "Type a model ID": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ພິມ ID ໂມເດວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ ID โมเดล"
