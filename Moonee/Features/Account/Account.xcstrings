{
  "sourceLanguage": "en",
  "strings": {
    "%@ / %@ per 1M": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@ ຕໍ່ 1 ລ້ານໂທເຄັນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@ ต่อ 1 ล้านโทเค็น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@ mỗi 1 triệu token"
          }
        }
      }
    },
    "%@ context": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍລິບົດ %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริบท %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngữ cảnh %@"
          }
        }
      }
    },
    "%@ · %@": {
      "shouldTranslate": false
    },
    "%lld models": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ໂມເດວ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld โมเดล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld model"
          }
        }
      }
    },
    "%lld transactions. Column names stay in English so the file imports back in any language.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ລາຍການ. ຊື່ຖັນຈະເປັນພາສາອັງກິດ ເພື່ອໃຫ້ນຳໄຟລ໌ກັບເຂົ້າມາໄດ້ບໍ່ວ່າຈະໃຊ້ພາສາໃດ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld รายการ ชื่อคอลัมน์จะเป็นภาษาอังกฤษ เพื่อให้นำไฟล์กลับเข้ามาได้ไม่ว่าจะใช้ภาษาไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giao dịch. Tên cột giữ bằng tiếng Anh để file nhập lại được với mọi ngôn ngữ."
          }
        }
      }
    },
    "A cloud model with your own key. Smartest, needs internet.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂມເດວຄລາວທີ່ໃຊ້ຄີຂອງເຈົ້າເອງ. ສະຫຼາດທີ່ສຸດ, ຕ້ອງໃຊ້ອິນເຕີເນັດ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลบนคลาวด์ที่ใช้คีย์ของคุณเอง ฉลาดที่สุด ต้องใช้อินเทอร์เน็ต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model cloud dùng key của bạn. Thông minh nhất, cần mạng."
          }
        }
      }
    },
    "A skill that is off never calls a model: Moonee shows the plain numbers instead.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທັກສະທີ່ປິດໄວ້ຈະບໍ່ເອີ້ນໃຊ້ໂມເດວ: Moonee ຈະສະແດງແຕ່ຕົວເລກໃຫ້ແທນ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทักษะที่ปิดอยู่จะไม่เรียกใช้โมเดล: Moonee จะแสดงแค่ตัวเลขให้แทน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skill đã tắt sẽ không gọi model: Moonee chỉ hiện số liệu."
          }
        }
      }
    },
    "AI assistant": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຜູ້ຊ່ວຍ AI"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ช่วย AI"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý AI"
          }
        }
      }
    },
    "AI mode": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂໝດ AI"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมด AI"
          }
        },
        "vi": {
          "stringUnit": {
