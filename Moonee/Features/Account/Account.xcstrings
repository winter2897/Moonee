        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ใช้ iCloud ไม่ได้ ข้อมูลของคุณยังปลอดภัยอยู่ใน iPhone เครื่องนี้ และจะซิงค์เมื่อ iCloud กลับมา"
          }
