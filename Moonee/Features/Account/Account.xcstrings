            "value": "ใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng"
          }
        }
      }
    },
    "Used for new transactions and for amounts like “45k”. Amounts already saved keep their currency.": {
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃຊ້ກັບລາຍການໃໝ່ ແລະ ການອ່ານຈຳນວນເງິນ ເຊັ່ນ “25ພັນ”. ຈຳນວນເງິນທີ່ບັນທຶກໄວ້ແລ້ວຈະໃຊ້ສະກຸນເງິນເດີມ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับรายการใหม่และการอ่านยอดเงิน เช่น “120” ส่วนยอดที่บันทึกไว้แล้วจะใช้สกุลเงินเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cho giao dịch mới và cách hiểu số tiền như “45k”. Số tiền đã lưu giữ nguyên tiền tệ."
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
