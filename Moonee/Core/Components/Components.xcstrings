          "stringUnit": {
            "state": "translated",
            "value": "เลยกำหนด %lld วัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá hạn %lld ngày"
          }
        }
      }
    },
