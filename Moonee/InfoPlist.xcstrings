{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "shouldTranslate": false
    },
    "NSCameraUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ໃຊ້ກ້ອງເພື່ອຖ່າຍຮູບໃບບິນຮັບເງິນ ແລະ ອ່ານຈຳນວນເງິນ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ใช้กล้องเพื่อถ่ายรูปใบเสร็จและอ่านยอดเงิน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee dùng camera để chụp hoá đơn và đọc số tiền."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ໃຊ້ Face ID ເພື່ອປົດລັອກແອັບ ເມື່ອເຈົ້າເປີດການລັອກແອັບໄວ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ใช้ Face ID เพื่อปลดล็อกแอปเมื่อคุณเปิดการล็อกแอปไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee dùng Face ID để mở khoá ứng dụng khi bạn bật khoá ứng dụng."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ໃຊ້ໄມໂຄຣໂຟນ ເພື່ອໃຫ້ເຈົ້າເວົ້າບັນທຶກລາຍການແທນການພິມ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ใช้ไมโครโฟนเพื่อให้คุณพูดบันทึกรายการแทนการพิมพ์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee dùng micro để bạn nói giao dịch thay vì gõ."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee shows your recent photos so you can attach receipts to the chat and read their amounts."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ສະແດງຮູບລ່າສຸດຂອງເຈົ້າ ເພື່ອໃຫ້ແນບໃບບິນຮັບເງິນໃນແຊັດ ແລະ ອ່ານຍອດເງິນໄດ້"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee แสดงรูปล่าสุดของคุณ เพื่อให้แนบใบเสร็จในแชตและอ่านยอดเงินได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee hiện các ảnh gần đây để bạn đính kèm hoá đơn vào cuộc trò chuyện và đọc số tiền."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee ປ່ຽນສຽງເວົ້າເປັນຂໍ້ຄວາມ ເພື່ອບັນທຶກລາຍການ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee แปลงเสียงพูดเป็นข้อความเพื่อบันทึกรายการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonee chuyển giọng nói thành chữ để ghi giao dịch."
          }
        }
      }
    }
  },
  "version": "1.0"
}
