<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE); keys build settings can't express. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- CloudKit pushes wake the app to pull iCloud changes (SwiftData sync). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<!-- First frame of the SwiftUI splash (App/Splash.swift): same colour, same Moonee, centred at its own size. -->
		<key>UIImageName</key>
		<string>moonee.greeting</string>
	</dict>
</dict>
</plist>
