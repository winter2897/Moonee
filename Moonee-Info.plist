<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE); keys build settings can't express. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- CloudKit pushes wake the app to pull iCloud changes (SwiftData sync). -->
	<!-- moonee://chat: widgets and the Control Center control open the chat composer. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.haiquan.moonee</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>moonee</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<!-- First frame of the SwiftUI splash (App/Splash.swift): same colour, same Moonee, centred at its own size. -->
		<key>UIImageName</key>
		<string>moonee.happy</string>
	</dict>
</dict>
</plist>
